# Run `npm run setup:admin` to create an account and populate these values locally.
# For hosted deployment, set the same environment variables in the hosting provider.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Use the project URL and server-side Secret API key from Supabase project settings.
# Keep this server key private; never prefix it with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SQLite file location (defaults to ./data/tischzeit.sqlite)
# DATABASE_PATH=./data/tischzeit.sqlite
